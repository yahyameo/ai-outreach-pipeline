# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# Sent as the x-api-key header on every endpoint except the SendGrid webhook.
OUTREACH_API_KEY=replace-with-a-long-random-secret
MONGODB_URI=mongodb://localhost:27017/outreach

# ── Sender identity (required for AI outreach) ───────────────────────────────
# Used in the email footer, reply-to, and the AI prompt.
OUTREACH_SENDER_NAME=Jane Doe
OUTREACH_SENDER_TITLE=Sales Consultant
# Optional translated titles: OUTREACH_SENDER_TITLE_<LOCALE>, e.g.
# OUTREACH_SENDER_TITLE_ES_MX=Consultora de Ventas
OUTREACH_COMPANY_NAME=Example Co
OUTREACH_COMPANY_DESCRIPTION=a software consultancy helping SMEs automate customer operations
# Replies (including "unsubscribe" requests) go here — use a monitored inbox.
OUTREACH_REPLY_TO=jane@example.com
OUTREACH_COMPANY_WEBSITE=https://example.com
# Optional; when unset the footer asks for a call without a link.
OUTREACH_BOOKING_URL=https://cal.com/jane
# Physical postal address (required by CAN-SPAM). Separate lines with "|".
# Quote the value if it contains "#" (e.g. a unit number), or dotenv drops the rest.
OUTREACH_COMPANY_ADDRESS="1 Example Street, #01-01|Singapore 000000"

# ── Lead discovery (Apify) ────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_your_token
# APIFY_MAPS_ACTOR=compass/crawler-google-places
WEBSITE_CONCURRENCY=5
MAX_WEBSITE_PAGES=4

# ── Email verification (Mails.so) ─────────────────────────────────────────────
MAILS_API_KEY=your-mails-so-api-key
MAILS_BATCH_SIZE=50
MAILS_POLL_INTERVAL_MS=2000
MAILS_POLL_TIMEOUT_MS=120000

# ── AI drafting (OpenAI) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
# Any Responses-API model that supports structured outputs.
OPENAI_OUTREACH_MODEL=gpt-5-mini

# ── Sending (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=sales@example.com
SENDGRID_FROM_NAME=Example Co
# Dynamic template used by the spreadsheet CLI (npm run mail).
SENDGRID_TEMPLATE_ID=d-your-template-id
# Required when a template uses <%asm_group_unsubscribe_raw_url%>.
SENDGRID_ASM_GROUP_ID=12345
# Public key from Mail Settings → Event Webhook → Signature Verification.
# The /webhooks/sendgrid endpoint rejects all requests until this is set.
SENDGRID_WEBHOOK_PUBLIC_KEY=
SEND_DELAY_MS=250
